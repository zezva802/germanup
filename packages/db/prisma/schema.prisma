generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                  String    @id @default(cuid())
  email               String    @unique
  name                String?
  avatar              String?
  provider            String    // "email" | "google"
  passwordHash        String?
  plan                Plan      @default(FREE)
  createdAt           DateTime  @default(now())
  streakCount         Int       @default(0)
  lastActiveDate      DateTime?
  streakFreezeUsedAt  DateTime?

  vocabulary     VocabWord[]
  verbs          UserVerb[]
  progress       TopicProgress[]
  sessions       PracticeSession[]
  subscription   Subscription?
  refreshTokens  RefreshToken[]
  dailyApiUsage  DailyApiUsage[]
  challengeResults ChallengeResult[]

  decks       Deck[]
  words       Word[]
  tags        Tag[]
  cardStates  CardState[]
  reviewLogs  ReviewLog[]
}

enum Plan {
  FREE
  PRO
}

model RefreshToken {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}

model VocabWord {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  german    String
  english   String
  gender    String? // "der" | "die" | "das" | null
  plural    String?
  example   String?
  level     String // "A1" | "A2" | "A3"
  createdAt DateTime @default(now())

  flashcardStats FlashcardStat?
}

model FlashcardStat {
  id              String    @id @default(cuid())
  wordId          String    @unique
  word            VocabWord @relation(fields: [wordId], references: [id], onDelete: Cascade)
  timesShown      Int       @default(0)
  timesCorrect    Int       @default(0)
  consecutiveKnew Int       @default(0)
  lastShown       DateTime?
  mastered        Boolean   @default(false)
}

model UserVerb {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id])
  infinitive  String
  isIrregular Boolean
  praesens    Json // {ich, du, er, wir, ihr, sie}
  imperfekt   Json
  partizip2   String
  hilfsverb   String // "haben" | "sein"
  example     String
  createdAt   DateTime @default(now())

  conjugationStats ConjugationStat[]
}

model ConjugationStat {
  id       String   @id @default(cuid())
  verbId   String
  verb     UserVerb @relation(fields: [verbId], references: [id], onDelete: Cascade)
  pronoun  String // "ich" | "du" | "er" | "wir" | "ihr" | "sie"
  tense    String // "praesens" | "imperfekt"
  attempts Int      @default(0)
  correct  Int      @default(0)

  @@unique([verbId, pronoun, tense])
}

model Exercise {
  id           String     @id @default(cuid())
  topic        String
  level        String
  type         ExType
  question     String
  options      Json? // string[] for multiple choice
  answer       String
  explanation  String
  difficulty   Difficulty
  imageUrl     String?
  timesShown   Int        @default(0)
  timesCorrect Int        @default(0)
}

enum ExType {
  FILL_BLANK
  MULTIPLE_CHOICE
  IDENTIFY
  TRANSLATE
  FREE_WRITE
  SORT
  BUILD
  ERROR_SPOT
  ECHO
}

enum Difficulty {
  EASY
  MEDIUM
  HARD
}

model WritingScenario {
  id               String     @id @default(cuid())
  topic            String
  level            String
  scenarioText     String
  expectedElements Json // string[]
  difficulty       Difficulty
}

model TopicProgress {
  id            String    @id @default(cuid())
  userId        String
  user          User      @relation(fields: [userId], references: [id])
  topic         String
  level         String
  exercisesDone Int       @default(0)
  correctCount  Int       @default(0)
  xp            Int       @default(0)
  lastPracticed DateTime?
  unlocked      Boolean   @default(false)

  @@unique([userId, topic, level])
}

model PracticeSession {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  type      String // "flashcard" | "grammar" | "conjugation"
  topic     String?
  score     Int
  total     Int
  duration  Int      @default(0) // seconds
  createdAt DateTime @default(now())
}

model DailyApiUsage {
  id       String @id @default(cuid())
  userId   String
  user     User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  date     String // YYYY-MM-DD
  endpoint String // "vocab/import" | "verbs/import" | "correct-translation" | "correct-freewrite"
  count    Int    @default(0)

  @@unique([userId, date, endpoint])
  @@index([userId])
}

model Subscription {
  id                String   @id @default(cuid())
  userId            String   @unique
  user              User     @relation(fields: [userId], references: [id])
  stripeCustomerId  String
  stripeSubId       String
  status            String // "active" | "cancelled" | "past_due"
  currentPeriodEnd  DateTime
}

model ChallengeResult {
  id            String   @id @default(cuid())
  userId        String
  challengeSlug String
  score         Int
  badge         String?
  completedAt   DateTime @default(now())
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, challengeSlug])
}

// ─── Words rework (DOG-102) ────────────────────────────────────────────────

enum PartOfSpeech {
  NOUN
  VERB
  ADJ
  ADV
  OTHER
}

enum CardStateType {
  NEW
  LEARNING
  REVIEW
  LAPSED
}

enum ReviewGrade {
  AGAIN
  GOOD
  EASY
}

model Deck {
  id          String   @id @default(cuid())
  ownerId     String? // null = curated/app-owned
  title       String
  description String?
  topic       String?
  level       String   @default("A1")
  isCurated   Boolean  @default(false)
  createdAt   DateTime @default(now())
  owner       User?    @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  words       Word[]

  @@index([ownerId])
  @@index([isCurated])
}

model Word {
  id           String       @id @default(cuid())
  ownerId      String? // null for curated (shared)
  deckId       String
  german       String
  english      String
  gender       String?
  plural       String?
  example      String?
  partOfSpeech PartOfSpeech @default(NOUN)
  conjugation  Json? // verbs: { praesens, imperfekt, partizip2, hilfsverb }
  level        String       @default("A1")
  source       String? // wiktionary | claude | manual | curated
  createdAt    DateTime     @default(now())
  owner        User?        @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  deck         Deck         @relation(fields: [deckId], references: [id], onDelete: Cascade)
  tags         WordTag[]
  cardStates   CardState[]

  @@index([deckId])
  @@index([ownerId])
}

model Tag {
  id      String    @id @default(cuid())
  ownerId String
  name    String
  owner   User      @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  words   WordTag[]

  @@unique([ownerId, name])
}

model WordTag {
  wordId String
  tagId  String
  word   Word @relation(fields: [wordId], references: [id], onDelete: Cascade)
  tag    Tag  @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([wordId, tagId])
}

model CardState {
  id             String        @id @default(cuid())
  userId         String
  wordId         String
  state          CardStateType @default(NEW)
  ease           Float         @default(2.5)
  intervalDays   Float         @default(0)
  dueAt          DateTime      @default(now())
  reps           Int           @default(0)
  lapses         Int           @default(0)
  learningStep   Int           @default(0) // index into the learning-steps ladder while in NEW/LEARNING/LAPSED
  lastReviewedAt DateTime?
  user           User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  word           Word          @relation(fields: [wordId], references: [id], onDelete: Cascade)

  @@unique([userId, wordId])
  @@index([userId, dueAt])
}

model ReviewLog {
  id            String      @id @default(cuid())
  userId        String
  wordId        String
  grade         ReviewGrade
  mode          String // flashcard | type | listening
  intervalAfter Float
  reviewedAt    DateTime    @default(now())
  user          User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, reviewedAt])
}
